# --- Database ---------------------------------------------------------------
# Local Postgres (docker-compose):
# DATABASE_URL="postgresql://leadpilot:leadpilot@localhost:5432/leadpilot?schema=public"
#
# Supabase-hosted Postgres — from Supabase dashboard: Settings > Database >
# Connection string > URI (direct connection, not the pooler, since Prisma
# runs migrations). Replace [YOUR-PASSWORD] with your project's database
# password (Settings > Database > Reset database password if forgotten —
# this is NOT the same as the sb_publishable_/sb_secret_ API keys).
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# --- Auth --------------------------------------------------------------------
# Random 32+ char secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# --- n8n webhook contract (app <-> n8n, both directions HMAC-signed) --------
# Base URL of your n8n instance's webhook endpoints, e.g. http://localhost:5678
N8N_WEBHOOK_BASE_URL="http://localhost:5678"
# Shared secret — must match the same value configured in n8n's Code nodes
N8N_WEBHOOK_SECRET="replace-with-a-long-random-secret"

# --- Redis (queues / rate limiting — reserved for future BullMQ jobs) -------
REDIS_URL="redis://localhost:6379"
