# --- Database ---------------------------------------------------------------
# Local Postgres (docker-compose): both vars can point at the same DB.
# DATABASE_URL="postgresql://leadpilot:leadpilot@localhost:5432/leadpilot?schema=public"
# DIRECT_URL="postgresql://leadpilot:leadpilot@localhost:5432/leadpilot?schema=public"
#
# Supabase-hosted Postgres — do NOT use the "direct connection" shown by
# default (db.<ref>.supabase.co:5432); it's IPv6-only and unreachable from
# most hosts (Render included). Use the pooler instead: Supabase dashboard
# → Settings → Database → Connection string → choose "Transaction pooler"
# for DATABASE_URL and "Session pooler" for DIRECT_URL (same host, ports
# 6543 vs 5432). Replace [YOUR-PASSWORD] with your project's database
# password (Settings → Database → Reset database password if forgotten —
# this is NOT the same as the sb_publishable_/sb_secret_ API keys).
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth --------------------------------------------------------------------
# Random 32+ char secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# --- n8n webhook contract (app <-> n8n, both directions HMAC-signed) --------
# Local n8n (docker-compose):
# N8N_WEBHOOK_BASE_URL="http://localhost:5678"
#
# n8n Cloud — the bare instance URL, no path. The app appends
# /webhook/<event> itself (see src/lib/n8n.ts), which must match each
# webhook trigger node's "Path" field exactly (just the event name, e.g.
# "lead.enriched" — no extra "webhook/" prefix). A workflow must be
# **Active** (top-right toggle in the n8n editor) for this persistent URL
# to work — the "Listen for test event" test URL only fires once.
N8N_WEBHOOK_BASE_URL="https://<your-subdomain>.app.n8n.cloud"
# A secret YOU generate (e.g. `openssl rand -base64 32`) — n8n doesn't
# provide this. Set the exact same value as a Variable named
# N8N_WEBHOOK_SECRET in n8n (left sidebar → Overview/Settings →
# Variables), read by every workflow's Code nodes via $vars.N8N_WEBHOOK_SECRET.
N8N_WEBHOOK_SECRET="replace-with-a-long-random-secret"

# --- APP_BASE_URL (set as a Variable in n8n, not here) -----------------------
# n8n's workflows call back into this app's API (PATCH /leads/:id, POST
# /agents/:id/runs, etc.) using an APP_BASE_URL Variable set in n8n
# ($vars.APP_BASE_URL). It must be a publicly reachable URL for this app —
# n8n Cloud cannot reach localhost or a sandboxed dev session, so this
# only works once the app is deployed (e.g. Render) or n8n is self-hosted
# on the same network as the app.

# --- Redis (queues / rate limiting — reserved for future BullMQ jobs) -------
REDIS_URL="redis://localhost:6379"

# --- Google AI Studio (optional — Ads "Generate with AI" preview only) -----
# Same key you set as the GOOGLE_AI_API_KEY Variable in n8n for every agent's
# LLM call, but set here too as a plain env var: this one specific feature
# (POST /api/ad-campaigns/:id/ai-preview, the "✨ Generate with AI" button on
# an ad campaign's Preview card) calls Google AI Studio directly from the
# app instead of through n8n, since it needs to feel instant for the person
# sitting on that page rather than round-tripping through an async webhook.
# Every other agent call in this app still goes through n8n. Leave unset and
# that one button just returns a clear "not configured" error — nothing else
# in the app depends on it.
# GOOGLE_AI_API_KEY="your-google-ai-studio-api-key"
