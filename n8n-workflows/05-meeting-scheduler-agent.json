{
  "name": "Agent 5 \u2014 Meeting Scheduler",
  "nodes": [
    {
      "id": "trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "notes": "Chained from Agent 4 when intent = interested. Can also be exposed as its own webhook.",
      "parameters": {}
    },
    {
      "id": "signGetPrompt",
      "name": "Sign: Get Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.`).digest('hex');\nreturn [{ json: { leadId: $json.leadId, orgId: $json.orgId, timestamp, signature } }];"
      }
    },
    {
      "id": "getPrompt",
      "name": "GET Agent Prompt (scheduler)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        -100
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "GET",
        "url": "={{$vars.APP_BASE_URL}}/api/agents/by-type/scheduler?orgId={{$json.orgId}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-signature",
              "value": "={{$json.signature}}"
            },
            {
              "name": "x-timestamp",
              "value": "={{$json.timestamp}}"
            }
          ]
        }
      }
    },
    {
      "id": "signGetLead",
      "name": "Sign: Get Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.`).digest('hex');\nreturn [{ json: { ...$json, timestamp, signature } }];"
      }
    },
    {
      "id": "getLead",
      "name": "GET Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        100
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "GET",
        "url": "={{$vars.APP_BASE_URL}}/api/leads/{{$json.leadId}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-signature",
              "value": "={{$json.signature}}"
            },
            {
              "name": "x-timestamp",
              "value": "={{$json.timestamp}}"
            }
          ]
        }
      }
    },
    {
      "id": "combinePromptLead",
      "name": "Combine Prompt & Lead",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition"
      }
    },
    {
      "id": "callClaude",
      "name": "Call LLM (Draft Booking Msg)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$vars.GOOGLE_AI_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify((() => { const m = $('GET Agent Prompt (scheduler)').first().json.agent.model; const model = (!m || /nemotron|openrouter/i.test(m)) ? 'gemini-3.5-flash-lite' : m; const isGemma = /^gemma/i.test(model); const body = { model, max_tokens: isGemma ? Math.max(256, 4096) : 256, messages: [{role:'system', content: $('GET Agent Prompt (scheduler)').first().json.agent.systemPrompt}, {role:'user', content: JSON.stringify($('GET Lead').first().json.lead)}] }; return body; })()) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "parseMsg",
      "name": "Parse Booking Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "const text = $input.first().json.choices[0].message.content;\nconst withoutThoughts = text.replace(/<thought>[\\s\\S]*?<\\/thought>/gi, '');\nconst cleaned = withoutThoughts.trim().replace(/^```(?:json)?\\s*|\\s*```$/g, '');\nconst parsed = JSON.parse(cleaned);\nconst bookingLink = $vars.CAL_COM_BOOKING_LINK || 'https://cal.com/your-team/intro';\nparsed.body = parsed.body.replace('{{booking_link}}', bookingLink);\nreturn [{ json: { leadId: $('Sign: Get Prompt').first().json.leadId, orgId: $('Sign: Get Prompt').first().json.orgId, agentId: $('GET Agent Prompt (scheduler)').first().json.agent.id, bookingLink, ...parsed } }];"
      }
    },
    {
      "id": "gmailSendBookingEmail",
      "name": "Gmail: Send Booking Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1540,
        0
      ],
      "notes": "Switched from Postmark (blocked by its pending-approval domain restriction) to Gmail, reusing the same gmailOAuth2 credential Agent 4 already uses to poll replies.",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "gmailOAuth2": {
          "id": "EupsvL2cglAZH0nv",
          "name": "Gmail account"
        }
      },
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('GET Lead').first().json.lead.email }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "extractGmailMessageId",
      "name": "Extract Gmail Message Id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1650,
        0
      ],
      "notes": "Gmail's API throws its own error on failure, so this just reshapes the response into the {messageId} shape Sign: Report Meeting Offer already expects.",
      "parameters": {
        "jsCode": "const res = $input.first().json;\nreturn [{ json: { messageId: res.id, threadId: res.threadId || res.id } }];"
      }
    },
    {
      "id": "signReport",
      "name": "Sign: Report Meeting Offer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst p = $('Parse Booking Message').first().json;\nconst messageId = $json.messageId;\nconst threadId = $json.threadId;\nconst body = { event: 'meeting.booked', orgId: p.orgId, leadId: p.leadId, agentType: 'scheduler', input: {}, output: { bookingLink: p.bookingLink, subject: p.subject, body: p.body, messageId, threadId }, requiresHumanReview: false };\nconst rawBody = JSON.stringify(body);\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\nreturn [{ json: { rawBody, timestamp, signature } }];"
      }
    },
    {
      "id": "postInbound",
      "name": "POST /webhooks/inbound",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        0
      ],
      "notes": "In production, prefer a Cal.com/Google Calendar 'booking confirmed' webhook to fire this instead of firing immediately after the invite email \u2014 this models the simpler 'propose a link' flow from the spec.",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "={{$vars.APP_BASE_URL}}/api/webhooks/inbound",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-signature",
              "value": "={{$json.signature}}"
            },
            {
              "name": "x-timestamp",
              "value": "={{$json.timestamp}}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json.rawBody}}"
      }
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Sign: Get Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign: Get Prompt": {
      "main": [
        [
          {
            "node": "GET Agent Prompt (scheduler)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Sign: Get Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign: Get Lead": {
      "main": [
        [
          {
            "node": "GET Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET Agent Prompt (scheduler)": {
      "main": [
        [
          {
            "node": "Combine Prompt & Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET Lead": {
      "main": [
        [
          {
            "node": "Combine Prompt & Lead",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Combine Prompt & Lead": {
      "main": [
        [
          {
            "node": "Call LLM (Draft Booking Msg)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call LLM (Draft Booking Msg)": {
      "main": [
        [
          {
            "node": "Parse Booking Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Booking Message": {
      "main": [
        [
          {
            "node": "Gmail: Send Booking Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail: Send Booking Email": {
      "main": [
        [
          {
            "node": "Extract Gmail Message Id",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Gmail Message Id": {
      "main": [
        [
          {
            "node": "Sign: Report Meeting Offer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign: Report Meeting Offer": {
      "main": [
        [
          {
            "node": "POST /webhooks/inbound",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
