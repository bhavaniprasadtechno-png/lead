{
  "name": "Agent 7 \u2014 Data Sync / Housekeeping",
  "nodes": [
    {
      "id": "trigger",
      "name": "Cron: Nightly 2am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "signOverview",
      "name": "Sign: Get Overview",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        -100
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.`).digest('hex');\nreturn [{ json: { orgId: $vars.ORG_ID || '2ab9b11b-94f9-475c-869a-f2572e7b0ed7', timestamp, signature } }];"
      }
    },
    {
      "id": "getOverview",
      "name": "GET /analytics/overview",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        -100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{$vars.APP_BASE_URL}}/api/analytics/overview?orgId={{$json.orgId}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-signature",
              "value": "={{$json.signature}}"
            },
            {
              "name": "x-timestamp",
              "value": "={{$json.timestamp}}"
            }
          ]
        }
      }
    },
    {
      "id": "signPrompt",
      "name": "Sign: Get Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        100
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.`).digest('hex');\nreturn [{ json: { orgId: $vars.ORG_ID || '2ab9b11b-94f9-475c-869a-f2572e7b0ed7', timestamp, signature } }];"
      }
    },
    {
      "id": "getPrompt",
      "name": "GET Agent Prompt (housekeeping)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{$vars.APP_BASE_URL}}/api/agents/by-type/housekeeping?orgId={{$json.orgId}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-signature",
              "value": "={{$json.signature}}"
            },
            {
              "name": "x-timestamp",
              "value": "={{$json.timestamp}}"
            }
          ]
        }
      }
    },
    {
      "id": "callClaude",
      "name": "Call LLM (Summarize)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$vars.GOOGLE_AI_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "={{ (() => { const m = $('GET Agent Prompt (housekeeping)').first().json.agent.model; return (!m || /nemotron|openrouter/i.test(m)) ? 'gemini-2.5-flash' : m; })() }}"
            },
            {
              "name": "max_tokens",
              "value": "512"
            },
            {
              "name": "messages",
              "value": "={{[{role:'system', content: $('GET Agent Prompt (housekeeping)').first().json.agent.systemPrompt}, {role:'user', content: JSON.stringify($('GET /analytics/overview').first().json)}]}}"
            },
            {
              "name": "reasoning_effort",
              "value": "none"
            }
          ]
        }
      }
    },
    {
      "id": "parseSummary",
      "name": "Parse Summary JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const text = $input.first().json.choices[0].message.content;\nconst cleaned = text.trim().replace(/^```(?:json)?\\s*|\\s*```$/g, '');\nconst parsed = JSON.parse(cleaned);\nreturn [{ json: parsed }];"
      }
    }
  ],
  "connections": {
    "Cron: Nightly 2am": {
      "main": [
        [
          {
            "node": "Sign: Get Overview",
            "type": "main",
            "index": 0
          },
          {
            "node": "Sign: Get Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign: Get Overview": {
      "main": [
        [
          {
            "node": "GET /analytics/overview",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign: Get Prompt": {
      "main": [
        [
          {
            "node": "GET Agent Prompt (housekeeping)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET /analytics/overview": {
      "main": [
        [
          {
            "node": "Call LLM (Summarize)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET Agent Prompt (housekeeping)": {
      "main": [
        [
          {
            "node": "Call LLM (Summarize)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call LLM (Summarize)": {
      "main": [
        [
          {
            "node": "Parse Summary JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
