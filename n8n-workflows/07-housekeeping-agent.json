{
  "name": "Agent 7 — Data Sync / Housekeeping",
  "nodes": [
    {
      "id": "trigger",
      "name": "Cron: Nightly 2am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 2 * * *" }] } }
    },
    {
      "id": "signOverview",
      "name": "Sign: Get Overview",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, -100],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.`).digest('hex');\nreturn [{ json: { orgId: $env.ORG_ID, timestamp, signature } }];"
      }
    },
    {
      "id": "getOverview",
      "name": "GET /analytics/overview",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, -100],
      "parameters": {
        "method": "GET",
        "url": "={{$env.APP_BASE_URL}}/api/analytics/overview?orgId={{$json.orgId}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-signature", "value": "={{$json.signature}}" },
            { "name": "x-timestamp", "value": "={{$json.timestamp}}" }
          ]
        }
      }
    },
    {
      "id": "signPrompt",
      "name": "Sign: Get Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 100],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.`).digest('hex');\nreturn [{ json: { orgId: $env.ORG_ID, timestamp, signature } }];"
      }
    },
    {
      "id": "getPrompt",
      "name": "GET Agent Prompt (housekeeping)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 100],
      "parameters": {
        "method": "GET",
        "url": "={{$env.APP_BASE_URL}}/api/agents/by-type/housekeeping?orgId={{$json.orgId}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-signature", "value": "={{$json.signature}}" },
            { "name": "x-timestamp", "value": "={{$json.timestamp}}" }
          ]
        }
      }
    },
    {
      "id": "callClaude",
      "name": "Call Claude (Summarize)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "={{$('GET Agent Prompt (housekeeping)').first().json.agent.model}}" },
            { "name": "max_tokens", "value": "512" },
            { "name": "system", "value": "={{$('GET Agent Prompt (housekeeping)').first().json.agent.systemPrompt}}" },
            { "name": "messages", "value": "={{[{role:'user', content: JSON.stringify($('GET /analytics/overview').first().json)}]}}" }
          ]
        }
      }
    },
    {
      "id": "parseSummary",
      "name": "Parse Summary JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 0],
      "parameters": {
        "jsCode": "const text = $input.first().json.content[0].text;\nconst parsed = JSON.parse(text);\nreturn [{ json: parsed }];"
      }
    },
    {
      "id": "postSlack",
      "name": "Slack: Post Daily Summary",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1100, 0],
      "notes": "Configure a Slack credential + channel for the daily digest.",
      "parameters": {
        "resource": "message",
        "operation": "post",
        "text": "={{$json.summary}}"
      }
    }
  ],
  "connections": {
    "Cron: Nightly 2am": {
      "main": [[
        { "node": "Sign: Get Overview", "type": "main", "index": 0 },
        { "node": "Sign: Get Prompt", "type": "main", "index": 0 }
      ]]
    },
    "Sign: Get Overview": { "main": [[{ "node": "GET /analytics/overview", "type": "main", "index": 0 }]] },
    "Sign: Get Prompt": { "main": [[{ "node": "GET Agent Prompt (housekeeping)", "type": "main", "index": 0 }]] },
    "GET /analytics/overview": { "main": [[{ "node": "Call Claude (Summarize)", "type": "main", "index": 0 }]] },
    "GET Agent Prompt (housekeeping)": { "main": [[{ "node": "Call Claude (Summarize)", "type": "main", "index": 0 }]] },
    "Call Claude (Summarize)": { "main": [[{ "node": "Parse Summary JSON", "type": "main", "index": 0 }]] },
    "Parse Summary JSON": { "main": [[{ "node": "Slack: Post Daily Summary", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
