    {
      "id": "verify",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst signature = $input.first().json.headers['x-signature'];\nconst timestamp = Number($input.first().json.headers['x-timestamp']);\nconst rawBody = JSON.stringify($input.first().json.body);\nconst expected = crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\nif (!signature || Math.abs(Date.now() - timestamp) > 5 * 60 * 1000 || signature !== expected) {\n  throw new Error('Invalid or stale webhook signature');\n}\nconst body = $input.first().json.body;\nreturn [{ json: { icpId: body.payload.icpId, runId: body.payload.runId, orgId: body.payload.orgId } }];"
      }
    },
    {
      "id": "signGetPrompt",
      "name": "Sign: Get Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
