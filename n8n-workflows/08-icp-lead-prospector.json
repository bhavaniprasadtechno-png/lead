      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3776,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst p = $('Parse Candidates JSON').first().json;\nconst body = { input: { icpId: p.icpId }, output: { candidateCount: p.candidates.length }, status: p.errorMessage ? 'failure' : 'success' };\nconst rawBody = JSON.stringify(body);\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\nreturn [{ json: { agentId: p.agentId, rawBody, timestamp, signature } }];"
      }
    },
