    {
      "id": "hunterEmailFinder",
      "name": "Hunter: Email Finder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2224,
        -220
      ],
      "notes": "Finds a real, verified email for a candidate by company + name. Requires the HUNTER_API_KEY n8n Variable (https://hunter.io) — free tier gives 25 searches/month. Only called when the candidate has a company name, since Hunter requires company or domain to search against.",
      "parameters": {
        "method": "GET",
        "url": "https://api.hunter.io/v2/email-finder",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "company",
              "value": "={{ $json.company }}"
            },
            {
              "name": "first_name",
              "value": "={{ $json.firstName }}"
            },
            {
              "name": "last_name",
              "value": "={{ $json.lastName }}"
            },
            {
              "name": "api_key",
              "value": "={{ $vars.HUNTER_API_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "applyHunterResult",
      "name": "Apply Hunter Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2448,
        -220
      ],
      "notes": "Only accepts Hunter's email if its own confidence score is >=50 - never fabricates or lowers the bar below what Hunter itself considers reliable.",
      "parameters": {
        "jsCode": "const original = $('IF: Has Company').item.json;\nconst res = $input.item.json || {};\nconst data = res.data || {};\nlet email = null;\nif (data.email && typeof data.score === 'number' && data.score >= 50) {\n  email = data.email;\n}\nreturn [{ json: { ...original, email } }];"
      }
    },
