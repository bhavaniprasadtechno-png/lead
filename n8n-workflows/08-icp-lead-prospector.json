{
  "name": "Agent 8 — ICP Lead Prospector",
  "nodes": [
    {
      "id": "trigger",
      "name": "Webhook: icp.discover",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "path": "icp.discover",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "verify",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst signature = $input.first().json.headers['x-signature'];\nconst timestamp = Number($input.first().json.headers['x-timestamp']);\nconst rawBody = JSON.stringify($input.first().json.body);\nconst expected = crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\nif (!signature || Math.abs(Date.now() - timestamp) > 5 * 60 * 1000 || signature !== expected) {\n  throw new Error('Invalid or stale webhook signature');\n}\nconst body = $input.first().json.body;\nreturn [{ json: { icpId: body.payload.icpId, runId: body.payload.runId, orgId: body.payload.orgId } }];"
      }
    },
    {
      "id": "signGetPrompt",
      "name": "Sign: Get Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        -160
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.`).digest('hex');\nreturn [{ json: { ...$json, timestamp, signature } }];"
      }
    },
    {
      "id": "getPrompt",
      "name": "GET Agent Prompt (prospector)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -160
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.APP_BASE_URL }}/api/agents/by-type/prospector?orgId={{ $json.orgId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-signature",
              "value": "={{ $json.signature }}"
            },
            {
              "name": "x-timestamp",
              "value": "={{ $json.timestamp }}"
            }
          ]
        }
      }
    },
    {
      "id": "signGetIcp",
      "name": "Sign: Get ICP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        160
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.`).digest('hex');\nreturn [{ json: { ...$('Verify Signature').first().json, timestamp, signature } }];"
      }
    },
    {
      "id": "getIcp",
      "name": "GET ICP Profile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        160
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.APP_BASE_URL }}/api/icp-profiles/{{ $json.icpId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-signature",
              "value": "={{ $json.signature }}"
            },
            {
              "name": "x-timestamp",
              "value": "={{ $json.timestamp }}"
            }
          ]
        }
      }
    },
    {
      "id": "combinePromptIcp",
      "name": "Combine Prompt & ICP",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      }
    },
    {
      "id": "buildSearchQuery",
      "name": "Build Search Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "jsCode": "const icp = $('GET ICP Profile').first().json.icpProfile;\nconst titles = Array.isArray(icp.jobTitles) ? icp.jobTitles : [];\nconst industries = Array.isArray(icp.industries) ? icp.industries : [];\nconst geographies = Array.isArray(icp.geographies) ? icp.geographies : [];\nconst keywords = Array.isArray(icp.keywords) ? icp.keywords : [];\nconst titlePart = titles.length ? '(' + titles.map((t) => '\"' + t + '\"').join(' OR ') + ')' : '';\nconst parts = ['site:linkedin.com/in', titlePart, industries.join(' '), geographies.join(' '), keywords.join(' ')].filter(Boolean);\nconst query = parts.join(' ');\nreturn [{ json: { query } }];"
      }
    },
    {
      "id": "serperSearch",
      "name": "Serper: Web Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        200
      ],
      "notes": "Grounds the LLM in real search results instead of asking it to answer from training data. Requires the SERPER_API_KEY n8n Variable (https://serper.dev).",
      "parameters": {
        "method": "POST",
        "url": "https://google.serper.dev/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-KEY",
              "value": "={{ $vars.SERPER_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.query }}"
            },
            {
              "name": "num",
              "value": "10"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "callClaude",
      "name": "Call LLM (Web Search)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $vars.OPENROUTER_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "={{ $('GET Agent Prompt (prospector)').first().json.agent.model }}"
            },
            {
              "name": "max_tokens",
              "value": "4096"
            },
            {
              "name": "messages",
              "value": "={{ [{role:'system', content: $('GET Agent Prompt (prospector)').first().json.agent.systemPrompt}, {role:'user', content: JSON.stringify({ icp: $('GET ICP Profile').first().json.icpProfile, searchQuery: $('Build Search Query').first().json.query, searchResults: ($('Serper: Web Search').first().json.organic || []).map(r => ({ title: r.title, link: r.link, snippet: r.snippet })) })}] }}"
            }
          ]
        }
      }
    },
    {
      "id": "parseCandidates",
      "name": "Parse Candidates JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "notes": "OpenRouter/OpenAI-style response: the model's answer is a plain string at choices[0].message.content (no block array like Anthropic's format).",
      "parameters": {
        "jsCode": "const text = $input.first().json.choices?.[0]?.message?.content;\nlet candidates = [];\nlet errorMessage = null;\ntry {\n  const parsed = JSON.parse(text);\n  candidates = Array.isArray(parsed.candidates) ? parsed.candidates : [];\n} catch (e) {\n  errorMessage = 'Failed to parse LLM response as JSON: ' + e.message;\n}\nreturn [{ json: { icpId: $('Verify Signature').first().json.icpId, runId: $('Verify Signature').first().json.runId, orgId: $('Verify Signature').first().json.orgId, agentId: $('GET Agent Prompt (prospector)').first().json.agent.id, candidates, errorMessage } }];"
      }
    },
    {
      "id": "signResults",
      "name": "Sign: Report Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1660,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst p = $json;\nconst body = p.errorMessage\n  ? { status: 'failed', errorMessage: p.errorMessage }\n  : { status: 'completed', candidates: p.candidates };\nconst rawBody = JSON.stringify(body);\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\nreturn [{ json: { ...p, rawBody, timestamp, signature } }];"
      }
    },
    {
      "id": "postResults",
      "name": "POST /icp-profiles/:id/runs/:runId/results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.APP_BASE_URL }}/api/icp-profiles/{{ $json.icpId }}/runs/{{ $json.runId }}/results",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-signature",
              "value": "={{ $json.signature }}"
            },
            {
              "name": "x-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.rawBody }}"
      }
    },
    {
      "id": "signRunLog",
      "name": "Sign: Log Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst p = $('Parse Candidates JSON').first().json;\nconst body = { input: { icpId: p.icpId }, output: { candidateCount: p.candidates.length }, status: p.errorMessage ? 'failure' : 'success' };\nconst rawBody = JSON.stringify(body);\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\nreturn [{ json: { agentId: p.agentId, rawBody, timestamp, signature } }];"
      }
    },
    {
      "id": "logRun",
      "name": "POST /agents/:id/runs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2320,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.APP_BASE_URL }}/api/agents/{{ $json.agentId }}/runs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-signature",
              "value": "={{ $json.signature }}"
            },
            {
              "name": "x-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.rawBody }}"
      }
    }
  ],
