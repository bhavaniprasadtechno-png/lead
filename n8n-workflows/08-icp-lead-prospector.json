    {
      "id": "buildSearchQuery",
      "name": "Build Search Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "jsCode": "const icp = $('GET ICP Profile').first().json.icpProfile;\nconst titles = Array.isArray(icp.jobTitles) ? icp.jobTitles : [];\nconst industries = Array.isArray(icp.industries) ? icp.industries : [];\nconst geographies = Array.isArray(icp.geographies) ? icp.geographies : [];\nconst technologies = Array.isArray(icp.technologies) ? icp.technologies : [];\nconst keywords = Array.isArray(icp.keywords) ? icp.keywords : [];\nconst parts = [titles.join(' '), industries.join(' '), geographies.join(' '), technologies.join(' '), keywords.join(' ')].filter(Boolean);\nconst query = parts.join(' ');\nreturn [{ json: { query } }];"
      }
    },
    {
      "id": "serperSearch",
      "name": "Tavily: Web Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        200
      ],
      "notes": "Grounds the LLM in real search results instead of asking it to answer from training data. Requires the TAVILY_API_KEY n8n Variable (free tier: 1,000 searches/month, no card - https://tavily.com). Unlike Serper (Google's raw operator syntax), Tavily accepts plain natural-language queries with no site:/OR/parentheses restrictions.",
      "parameters": {
        "method": "POST",
        "url": "https://api.tavily.com/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ api_key: $vars.TAVILY_API_KEY, query: $json.query, max_results: 20, search_depth: 'basic' }) }}"
      }
    },
    {
      "id": "callClaude",
      "name": "Call LLM (Web Search)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $vars.GOOGLE_AI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify((() => { const m = $('GET Agent Prompt (prospector)').first().json.agent.model; const model = (!m || /nemotron|openrouter/i.test(m)) ? 'gemma-4-31b-it' : m; const isGemma = /^gemma/i.test(model); const body = { model, max_tokens: 4096, messages: [{role:'system', content: $('GET Agent Prompt (prospector)').first().json.agent.systemPrompt}, {role:'user', content: JSON.stringify({ icp: $('GET ICP Profile').first().json.icpProfile, searchQuery: $('Build Search Query').first().json.query, searchResults: ($('Tavily: Web Search').first().json.results || []).map(r => ({ title: r.title, link: r.url, snippet: r.content })) })}] }; if (!isGemma) body.reasoning_effort = 'none'; return body; })()) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "parseCandidates",
      "name": "Parse Candidates JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "notes": "OpenRouter/OpenAI-style response: the model's answer is a plain string at choices[0].message.content (no block array like Anthropic's format). OpenRouter sometimes proxies an upstream provider error (e.g. Nvidia overloaded) back as a 200 response body with an `error` field instead of `choices` — handled below so that shows up as a real message, not a JSON.parse crash.",
      "parameters": {
        "jsCode": "const response = $input.first().json;\nlet candidates = [];\nlet errorMessage = null;\nif (response.error) {\n  errorMessage = 'LLM call failed: ' + (response.error.message || JSON.stringify(response.error));\n} else {\n  const text = response.choices?.[0]?.message?.content;\n  if (!text) {\n    errorMessage = 'LLM returned no content (empty response)';\n  } else {\n    try {\n      const withoutThoughts = text.replace(/<thought>[\\s\\S]*?<\\/thought>/gi, '');\n      const cleaned = withoutThoughts.trim().replace(/^```(?:json)?\\s*|\\s*```$/g, '');\n      const parsed = JSON.parse(cleaned);\n      candidates = Array.isArray(parsed.candidates) ? parsed.candidates : [];\n    } catch (e) {\n      errorMessage = 'Failed to parse LLM response as JSON: ' + e.message;\n    }\n  }\n}\nreturn [{ json: { icpId: $('Verify Signature').first().json.icpId, runId: $('Verify Signature').first().json.runId, orgId: $('Verify Signature').first().json.orgId, agentId: $('GET Agent Prompt (prospector)').first().json.agent.id, candidates, errorMessage } }];"
      }
    },
    {
      "id": "signResults",
      "name": "Sign: Report Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3344,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst p = $json;\nconst body = p.errorMessage\n  ? { status: 'failed', errorMessage: p.errorMessage }\n  : { status: 'completed', candidates: p.candidates };\nconst rawBody = JSON.stringify(body);\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\nreturn [{ json: { ...p, rawBody, timestamp, signature } }];"
      }
    },
