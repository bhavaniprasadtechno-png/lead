{
  "name": "Agent 6 — Sequence / Drip Orchestrator",
  "nodes": [
    {
      "id": "trigger",
      "name": "Cron: Every 30 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 30 }] } }
    },
    {
      "id": "signDue",
      "name": "Sign: Get Due Steps",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "notes": "ORG_ID is single-tenant here for simplicity; for multi-org, precede this with a loop over an org list.",
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.`).digest('hex');\nreturn [{ json: { orgId: $vars.ORG_ID, timestamp, signature } }];"
      }
    },
    {
      "id": "getDue",
      "name": "GET /sequences/due",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "parameters": {
        "method": "GET",
        "url": "={{$vars.APP_BASE_URL}}/api/sequences/due?orgId={{$json.orgId}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-signature", "value": "={{$json.signature}}" },
            { "name": "x-timestamp", "value": "={{$json.timestamp}}" }
          ]
        }
      }
    },
    {
      "id": "splitEnrollments",
      "name": "Split Out Enrollments",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [660, 0],
      "parameters": { "fieldToSplitOut": "enrollments" }
    },
    {
      "id": "signGetPrompt",
      "name": "Sign: Get Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 0],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.`).digest('hex');\nreturn [{ json: { ...$json, timestamp, signature } }];"
      }
    },
    {
      "id": "getPrompt",
      "name": "GET Agent Prompt (orchestrator)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 0],
      "parameters": {
        "method": "GET",
        "url": "={{$vars.APP_BASE_URL}}/api/agents/by-type/orchestrator?orgId={{$('Sign: Get Due Steps').first().json.orgId}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-signature", "value": "={{$json.signature}}" },
            { "name": "x-timestamp", "value": "={{$json.timestamp}}" }
          ]
        }
      }
    },
    {
      "id": "callClaude",
      "name": "Call Claude (Should Send?)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 0],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "={{$('GET Agent Prompt (orchestrator)').first().json.agent.model}}" },
            { "name": "max_tokens", "value": "256" },
            { "name": "system", "value": "={{$('GET Agent Prompt (orchestrator)').first().json.agent.systemPrompt}}" },
            { "name": "messages", "value": "={{[{role:'user', content: JSON.stringify($('Split Out Enrollments').item.json)}]}}" }
          ]
        }
      }
    },
    {
      "id": "parseDecision",
      "name": "Parse Decision JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 0],
      "parameters": {
        "jsCode": "const text = $input.first().json.content[0].text;\nconst parsed = JSON.parse(text);\nconst enrollment = $('Split Out Enrollments').item.json;\nconst step = enrollment.sequence.steps.find(s => s.order === enrollment.currentStep) || enrollment.sequence.steps[0];\nreturn [{ json: { ...parsed, leadId: enrollment.lead.id, orgId: enrollment.sequence.campaign.orgId, enrollmentId: enrollment.id, templateId: step ? step.templateId : null } }];"
      }
    },
    {
      "id": "ifShouldSend",
      "name": "IF: Should Send",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1760, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{$json.should_send}}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "triggerWriter",
      "name": "Call Agent 3 (Writer)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [1980, -80],
      "parameters": {
        "workflowId": "={{ 'agent-3-email-personalization' }}",
        "workflowInputs": {
          "value": {
            "leadId": "={{$json.leadId}}",
            "orgId": "={{$json.orgId}}",
            "templateId": "={{$json.templateId}}",
            "enrollmentId": "={{$json.enrollmentId}}"
          }
        }
      }
    }
  ],
  "connections": {
    "Cron: Every 30 min": { "main": [[{ "node": "Sign: Get Due Steps", "type": "main", "index": 0 }]] },
    "Sign: Get Due Steps": { "main": [[{ "node": "GET /sequences/due", "type": "main", "index": 0 }]] },
    "GET /sequences/due": { "main": [[{ "node": "Split Out Enrollments", "type": "main", "index": 0 }]] },
    "Split Out Enrollments": { "main": [[{ "node": "Sign: Get Prompt", "type": "main", "index": 0 }]] },
    "Sign: Get Prompt": { "main": [[{ "node": "GET Agent Prompt (orchestrator)", "type": "main", "index": 0 }]] },
    "GET Agent Prompt (orchestrator)": { "main": [[{ "node": "Call Claude (Should Send?)", "type": "main", "index": 0 }]] },
    "Call Claude (Should Send?)": { "main": [[{ "node": "Parse Decision JSON", "type": "main", "index": 0 }]] },
    "Parse Decision JSON": { "main": [[{ "node": "IF: Should Send", "type": "main", "index": 0 }]] },
    "IF: Should Send": { "main": [[{ "node": "Call Agent 3 (Writer)", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" }
}
