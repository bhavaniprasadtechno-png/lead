{
  "name": "Agent 4 \u2014 Reply Intent Classifier",
  "nodes": [
    {
      "id": "trigger",
      "name": "Gmail Trigger: New Reply",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "notes": "Swap for Microsoft Graph trigger if using Outlook. Polls the shared sales inbox.",
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {}
      }
    },
    {
      "id": "signMatchThread",
      "name": "Sign: Match Thread",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.`).digest('hex');\nreturn [{ json: { threadId: $json.threadId, replyText: $json.snippet || $json.text, timestamp, signature } }];"
      }
    },
    {
      "id": "matchThread",
      "name": "GET Lead by Thread",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{$vars.APP_BASE_URL}}/api/leads/by-thread/{{$json.threadId}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-signature",
              "value": "={{$json.signature}}"
            },
            {
              "name": "x-timestamp",
              "value": "={{$json.timestamp}}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "ifLeadFound",
      "name": "IF: Lead Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        560,
        150
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ !!$json.lead }}",
              "operator": {
                "operation": "equals",
                "type": "boolean"
              },
              "rightValue": true
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        }
      }
    },
    {
      "id": "signGetPrompt",
      "name": "Sign: Get Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.`).digest('hex');\nreturn [{ json: { orgId: $json.orgId, lead: $json.lead, replyText: $('Sign: Match Thread').first().json.replyText, timestamp, signature } }];"
      }
    },
    {
      "id": "getPrompt",
      "name": "GET Agent Prompt (classifier)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "GET",
        "url": "={{$vars.APP_BASE_URL}}/api/agents/by-type/classifier?orgId={{$json.orgId}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-signature",
              "value": "={{$json.signature}}"
            },
            {
              "name": "x-timestamp",
              "value": "={{$json.timestamp}}"
            }
          ]
        }
      }
    },
    {
      "id": "callClaude",
      "name": "Call LLM (Classify Reply)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$vars.GOOGLE_AI_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify((() => { const m = $('GET Agent Prompt (classifier)').first().json.agent.model; const model = (!m || /nemotron|openrouter/i.test(m)) ? 'gemini-3.5-flash-lite' : m; const isGemma = /^gemma/i.test(model); const body = { model, max_tokens: isGemma ? Math.max(512, 4096) : 512, messages: [{role:'system', content: $('GET Agent Prompt (classifier)').first().json.agent.systemPrompt}, {role:'user', content: JSON.stringify({ reply: $('Sign: Get Prompt').first().json.replyText })}] }; return body; })()) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "parseIntent",
      "name": "Parse Intent JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "const text = $input.first().json.choices[0].message.content;\nconst withoutThoughts = text.replace(/<thought>[\\s\\S]*?<\\/thought>/gi, '');\nconst cleaned = withoutThoughts.trim().replace(/^```(?:json)?\\s*|\\s*```$/g, '');\nconst parsed = JSON.parse(cleaned);\nreturn [{ json: { orgId: $('Sign: Get Prompt').first().json.orgId, leadId: $('Sign: Get Prompt').first().json.lead.id, ...parsed } }];"
      }
    },
    {
      "id": "signReport",
      "name": "Sign: Report Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "notes": "IMPORTANT: forwards the lead's actual reply text (replyText, already available in-workflow from Sign: Get Prompt -- the same value fed to the classifier LLM) as part of both input and output. This used to send input.reply as the literal string 'redacted' and only forward the classifier's output, so the lead's actual reply was never persisted anywhere in the app -- there was no way to view what a lead had actually written back, only the AI's classification of it.",
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst p = $json;\nconst replyText = $('Sign: Get Prompt').first().json.replyText;\nconst body = { event: 'reply.classified', orgId: p.orgId, leadId: p.leadId, agentType: 'classifier', input: { reply: replyText }, output: { intent: p.intent, confidence: p.confidence, suggested_reply: p.suggested_reply, replyText: replyText }, requiresHumanReview: p.requires_human_review === true };\nconst rawBody = JSON.stringify(body);\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\nreturn [{ json: { ...p, rawBody, timestamp, signature } }];"
      }
    },
    {
      "id": "postInbound",
      "name": "POST /webhooks/inbound",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        0
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "={{$vars.APP_BASE_URL}}/api/webhooks/inbound",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-signature",
              "value": "={{$json.signature}}"
            },
            {
              "name": "x-timestamp",
              "value": "={{$json.timestamp}}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json.rawBody}}"
      }
    },
    {
      "id": "ifInterested",
      "name": "IF: Interested",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$('Parse Intent JSON').first().json.intent}}",
              "rightValue": "interested",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "triggerScheduler",
      "name": "Call Agent 5 (Scheduler)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2200,
        -80
      ],
      "parameters": {
        "workflowId": "={{ 'agent-5-meeting-scheduler' }}",
        "workflowInputs": {
          "value": {
            "leadId": "={{$('Parse Intent JSON').first().json.leadId}}",
            "orgId": "={{$('Parse Intent JSON').first().json.orgId}}"
          }
        }
      }
    }
  ],
  "connections": {
    "Gmail Trigger: New Reply": {
      "main": [
        [
          {
            "node": "Sign: Match Thread",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign: Match Thread": {
      "main": [
        [
          {
            "node": "GET Lead by Thread",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET Lead by Thread": {
      "main": [
        [
          {
            "node": "IF: Lead Found",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF: Lead Found": {
      "main": [
        [
          {
            "node": "Sign: Get Prompt",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Sign: Get Prompt": {
      "main": [
        [
          {
            "node": "GET Agent Prompt (classifier)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET Agent Prompt (classifier)": {
      "main": [
        [
          {
            "node": "Call LLM (Classify Reply)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call LLM (Classify Reply)": {
      "main": [
        [
          {
            "node": "Parse Intent JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Intent JSON": {
      "main": [
        [
          {
            "node": "Sign: Report Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign: Report Reply": {
      "main": [
        [
          {
            "node": "POST /webhooks/inbound",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /webhooks/inbound": {
      "main": [
        [
          {
            "node": "IF: Interested",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF: Interested": {
      "main": [
        [
          {
            "node": "Call Agent 5 (Scheduler)",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
