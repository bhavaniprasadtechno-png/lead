{
  "name": "Agent 3 \u2014 Email Personalization & Sender",
  "nodes": [
    {
      "id": "trigger",
      "name": "Webhook: lead.qualified",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "path": "lead.qualified",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "verify",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst signature = $input.first().json.headers['x-signature'];\nconst timestamp = Number($input.first().json.headers['x-timestamp']);\nconst rawBody = JSON.stringify($input.first().json.body);\nconst expected = crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\nif (!signature || Math.abs(Date.now() - timestamp) > 5 * 60 * 1000 || signature !== expected) {\n  throw new Error('Invalid or stale webhook signature');\n}\nconst body = $input.first().json.body;\nreturn [{ json: { leadId: body.payload.leadId, orgId: body.payload.orgId, templateId: body.payload.templateId, enrollmentId: body.payload.enrollmentId || null } }];"
      }
    },
    {
      "id": "sendEnabled",
      "name": "IF: Sending Enabled",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "notes": "Feature-flagged behind a hard daily send cap until deliverability is validated (per spec step 10).",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$vars.SEND_ENABLED}}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "executeWorkflowTrigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        220,
        260
      ],
      "notes": "Lets Agent 6 (or any caller) invoke this workflow directly via Execute Workflow, bypassing HMAC verification since it's an internal n8n-to-n8n call. Feeds the same {leadId, orgId, templateId, enrollmentId} shape into IF: Sending Enabled that Verify Signature produces for the webhook path.",
      "parameters": {
        "workflowInputs": {
          "values": [
            { "name": "leadId" },
            { "name": "orgId" },
            { "name": "templateId" },
            { "name": "enrollmentId" }
          ]
        }
      }
    },
    {
      "id": "sendingEnabledNoOp",
      "name": "Sending Enabled",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "parameters": {}
    },
    {
      "id": "combinePromptLeadTemplate",
      "name": "Combine Prompt, Lead & Template",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        980,
