    {
      "id": "callClaude",
      "name": "Call LLM (Draft Email)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$vars.GOOGLE_AI_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "={{$('GET Agent Prompt (writer)').first().json.agent.model}}"
            },
            {
              "name": "max_tokens",
              "value": "512"
            },
            {
              "name": "messages",
              "value": "={{[{role:'system', content: $('GET Agent Prompt (writer)').first().json.agent.systemPrompt}, {role:'user', content: JSON.stringify({ lead: $('GET Lead').first().json.lead, template: $('GET Template').first().json.template })}]}}"
            }
          ]
        }
      }
    },
    {
      "id": "parseEmail",
      "name": "Parse Email JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "const text = $input.first().json.choices[0].message.content;\nconst parsed = JSON.parse(text);\nreturn [{ json: { leadId: $('Verify Signature').first().json.leadId, orgId: $('Verify Signature').first().json.orgId, enrollmentId: $('Verify Signature').first().json.enrollmentId, agentId: $('GET Agent Prompt (writer)').first().json.agent.id, ...parsed } }];"
      }
    },
    {
      "id": "sendEmail",
      "name": "Postmark: Send Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "notes": "Replace with your Postmark/SES credential.",
      "parameters": {
        "method": "POST",
        "url": "https://api.postmarkapp.com/email",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "postmarkApi",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "To",
              "value": "={{$('GET Lead').first().json.lead.email}}"
            },
            {
              "name": "Subject",
              "value": "={{$json.subject}}"
            },
            {
              "name": "TextBody",
              "value": "={{$json.body}}"
            }
          ]
        }
      }
    },
    {
      "id": "signInbound",
      "name": "Sign: Report Sent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst parsed = $('Parse Email JSON').first().json;\nconst body = { event: 'sequence.step_sent', orgId: parsed.orgId, leadId: parsed.leadId, enrollmentId: parsed.enrollmentId, agentType: 'writer', input: { templateId: parsed.templateId }, output: { subject: parsed.subject, body: parsed.body }, nextStepDueAt: null };\nconst rawBody = JSON.stringify(body);\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\nreturn [{ json: { rawBody, timestamp, signature } }];"
      }
    },
    {
      "id": "postInbound",
      "name": "POST /webhooks/inbound",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$vars.APP_BASE_URL}}/api/webhooks/inbound",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-signature",
              "value": "={{$json.signature}}"
            },
            {
              "name": "x-timestamp",
              "value": "={{$json.timestamp}}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json.rawBody}}"
      }
    }
  ],
