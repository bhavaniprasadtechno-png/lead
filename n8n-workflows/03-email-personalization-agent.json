    {
      "id": "callClaude",
      "name": "Call LLM (Draft Email)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$vars.GOOGLE_AI_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify((() => { const m = $('GET Agent Prompt (writer)').first().json.agent.model; const model = (!m || /nemotron|openrouter/i.test(m)) ? 'gemini-3.5-flash-lite' : m; const isGemma = /^gemma/i.test(model); const body = { model, max_tokens: isGemma ? Math.max(512, 4096) : 512, messages: [{role:'system', content: $('GET Agent Prompt (writer)').first().json.agent.systemPrompt}, {role:'user', content: JSON.stringify({ lead: $('GET Lead').first().json.lead, template: $('GET Template').first().json.template })}] }; return body; })()) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "ifHasEmail",
      "name": "IF: Has Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        980,
        150
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ !!$('GET Lead').first().json.lead.email }}",
              "operator": {
                "operation": "equals",
                "type": "boolean"
              },
              "rightValue": true
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        }
      }
    },
    {
      "id": "parseEmail",
      "name": "Parse Email JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "const text = $input.first().json.choices[0].message.content;\nconst withoutThoughts = text.replace(/<thought>[\\s\\S]*?<\\/thought>/gi, '');\nconst cleaned = withoutThoughts.trim().replace(/^```(?:json)?\\s*|\\s*```$/g, '');\nconst parsed = JSON.parse(cleaned);\nreturn [{ json: { leadId: $('Sending Enabled').first().json.leadId, orgId: $('Sending Enabled').first().json.orgId, enrollmentId: $('Sending Enabled').first().json.enrollmentId, agentId: $('GET Agent Prompt (writer)').first().json.agent.id, ...parsed } }];"
      }
    },
    {
      "id": "gmailSendEmail",
      "name": "Gmail: Send Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1980,
        0
      ],
      "notes": "Switched from Postmark (blocked by its pending-approval domain restriction -- confirmed live: a real send to a real lead's domain was rejected with ErrorCode 412) to Gmail, reusing the same gmailOAuth2 credential Agent 4 already uses to poll replies. appendAttribution is off so outreach doesn't carry an n8n footer.",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "gmailOAuth2": {
          "id": "EupsvL2cglAZH0nv",
          "name": "Gmail account"
        }
      },
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('GET Lead').first().json.lead.email }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "extractGmailMessageId",
      "name": "Extract Gmail Message Id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2090,
        0
      ],
      "notes": "Gmail's API throws its own error on failure (unlike Postmark, there's no HTTP-200-but-failed edge case to separately check for), so this just reshapes the response into the {messageId} shape Sign: Report Sent already expects.",
      "parameters": {
        "jsCode": "const res = $input.first().json;\nreturn [{ json: { messageId: res.id, threadId: res.threadId || res.id } }];"
      }
    },
    {
      "id": "signInbound",
      "name": "Sign: Report Sent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $vars.N8N_WEBHOOK_SECRET;\nconst timestamp = Date.now();\nconst parsed = $('Parse Email JSON').first().json;\nconst messageId = $json.messageId;\nconst threadId = $json.threadId;\nconst body = { event: 'sequence.step_sent', orgId: parsed.orgId, leadId: parsed.leadId, enrollmentId: parsed.enrollmentId, agentType: 'writer', input: { templateId: parsed.templateId }, output: { subject: parsed.subject, body: parsed.body, messageId, threadId }, nextStepDueAt: null };\nconst rawBody = JSON.stringify(body);\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\nreturn [{ json: { rawBody, timestamp, signature } }];"
      }
    },
    {
      "id": "postInbound",
      "name": "POST /webhooks/inbound",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        0
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "={{$vars.APP_BASE_URL}}/api/webhooks/inbound",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-signature",
              "value": "={{$json.signature}}"
            },
            {
              "name": "x-timestamp",
              "value": "={{$json.timestamp}}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json.rawBody}}"
      }
    }
  ],
