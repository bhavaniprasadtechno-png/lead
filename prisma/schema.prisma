// AI-Powered Lead Generation & Management Platform
// Database schema (system of record). n8n / external agents read & write
// exclusively through the REST API layer in src/app/api — never directly.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev + Render's (glibc) native Node runtime;
  // linux-musl-openssl-3.0.x covers the Alpine-based Dockerfile used by
  // docker-compose / any Docker-based deploy.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Runtime queries go through Supabase's transaction-mode pooler (IPv4,
  // pgbouncer) — Supabase's *direct* host (db.<ref>.supabase.co) is
  // IPv6-only, which most hosts (Render included) can't reach.
  url = env("DATABASE_URL")
  // Migrations need a session-level connection (advisory locks, DDL),
  // which pgbouncer's transaction mode doesn't support — this points at
  // the session-mode pooler instead, still IPv4.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Organizations & Users
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  plan      String   @default("trial")
  createdAt DateTime @default(now()) @map("created_at")

  users             User[]
  leads             Lead[]
  campaigns         Campaign[]
  emailTemplates    EmailTemplate[]
  agents            Agent[]
  integrations      Integration[]
  icpProfiles       IcpProfile[]
  leadDiscoveryRuns LeadDiscoveryRun[]

  @@map("organizations")
}

enum UserRole {
  owner
  admin
  rep
}

model User {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(rep)
  createdAt    DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ownedLeads   Lead[]        @relation("LeadOwner")

  @@index([orgId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

enum LeadStatus {
  new
  enriching
  scoring
  qualified
  disqualified
  contacted
  engaged
  meeting_booked
  won
  lost
}

enum LeadSource {
  web_form
  landing_page
  csv_import
  linkedin
  referral
  manual
  ai_discovery
  other
}

model Lead {
  id             String     @id @default(uuid())
  orgId          String     @map("org_id")
  source         LeadSource @default(manual)
  firstName      String     @map("first_name")
  lastName       String?    @map("last_name")
  email          String?
  phone          String?
  company        String?
  jobTitle       String?    @map("job_title")
  linkedinUrl    String?    @map("linkedin_url")
  website        String?
  status         LeadStatus @default(new)
  score          Int?
  scoreReason    String?    @map("score_reason")
  ownerId        String?    @map("owner_id")
  icpId          String?    @map("icp_id")
  discoveryRunId String?    @map("discovery_run_id")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner        User?             @relation("LeadOwner", fields: [ownerId], references: [id])
  icp          IcpProfile?       @relation(fields: [icpId], references: [id], onDelete: SetNull)
  discoveryRun LeadDiscoveryRun? @relation(fields: [discoveryRunId], references: [id], onDelete: SetNull)
  enrichment   LeadEnrichment?
  activities   Activity[]
  emailLogs    EmailLog[]
  agentRuns    AgentRun[]
  sequenceEnrollments SequenceEnrollment[]

  @@index([orgId, status])
  @@index([orgId, email])
  @@map("leads")
}

model LeadEnrichment {
  id                String   @id @default(uuid())
  leadId            String   @unique @map("lead_id")
  companySize       String?  @map("company_size")
  industry          String?
  revenueRange      String?  @map("revenue_range")
  technologiesUsed  Json?    @map("technologies_used")
  socialProfiles    Json?    @map("social_profiles")
  rawPayload        Json?    @map("raw_payload")
  enrichedAt        DateTime @default(now()) @map("enriched_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_enrichment")
}

// ---------------------------------------------------------------------------
// ICP-driven lead discovery — user defines an Ideal Customer Profile, the
// Prospector agent (n8n + Claude web search) searches the web for matching
// candidates and reports them back; verifiable candidates (a real email
// found) become Leads via the normal enrichment → scoring → outreach
// pipeline, just like any other source.
// ---------------------------------------------------------------------------

model IcpProfile {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  name           String
  description    String?
  industries     Json?    // string[]
  companySizeMin Int?     @map("company_size_min")
  companySizeMax Int?     @map("company_size_max")
  jobTitles      Json?    // string[] — target personas/seniority
  geographies    Json?    // string[]
  technologies   Json?    // string[] — tech-stack signals
  keywords       Json?    // string[] — other buying-intent signals
  exclusions     String?  // free text: what to rule out
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads         Lead[]
  discoveryRuns LeadDiscoveryRun[]

  @@index([orgId])
  @@map("icp_profiles")
}

enum DiscoveryRunStatus {
  queued
  running
  completed
  failed
}

model LeadDiscoveryRun {
  id           String             @id @default(uuid())
  icpId        String             @map("icp_id")
  orgId        String             @map("org_id")
  status       DiscoveryRunStatus @default(queued)
  triggeredBy  String?            @map("triggered_by")
  // Full candidate list the Prospector agent returned, including
  // candidates that didn't become a Lead (no verifiable email found) —
  // kept for transparency/audit even though only a subset get imported.
  candidates   Json?
  leadsFound   Int?               @map("leads_found")
  leadsCreated Int?               @map("leads_created")
  leadsSkipped Int?               @map("leads_skipped")
  errorMessage String?            @map("error_message")
  startedAt    DateTime           @default(now()) @map("started_at")
  completedAt  DateTime?          @map("completed_at")

  icp          IcpProfile   @relation(fields: [icpId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@index([icpId])
  @@map("lead_discovery_runs")
}

// ---------------------------------------------------------------------------
// Campaigns & Sequences
// ---------------------------------------------------------------------------

enum CampaignStatus {
  draft
  active
  paused
  archived
}

model Campaign {
  id        String         @id @default(uuid())
  orgId     String         @map("org_id")
  name      String
  goal      String?
  status    CampaignStatus @default(draft)
  createdAt DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sequences    Sequence[]

  @@index([orgId])
  @@map("campaigns")
}

enum SequenceTrigger {
  lead_qualified
  manual
  form_submission
}

model Sequence {
  id          String          @id @default(uuid())
  campaignId  String          @map("campaign_id")
  name        String
  triggerType SequenceTrigger @default(lead_qualified) @map("trigger_type")
  // steps: [{ order, delayHours, templateId, condition }]
  steps       Json

  campaign    Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  enrollments SequenceEnrollment[]

  @@map("sequences")
}

// Tracks a lead's progress through a sequence — what Agent 6 (drip
// orchestrator) polls via GET /api/sequences/due.
model SequenceEnrollment {
  id              String    @id @default(uuid())
  sequenceId      String    @map("sequence_id")
  leadId          String    @map("lead_id")
  currentStep     Int       @default(0) @map("current_step")
  nextStepDueAt   DateTime? @map("next_step_due_at")
  completedAt     DateTime? @map("completed_at")
  stoppedReason   String?   @map("stopped_reason")
  createdAt       DateTime  @default(now()) @map("created_at")

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([nextStepDueAt])
  @@map("sequence_enrollments")
}

model EmailTemplate {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  name        String
  subject     String
  bodyPrompt  String   @map("body_prompt")
  tone        String   @default("professional")
  variables   Json?
  createdAt   DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("email_templates")
}

// ---------------------------------------------------------------------------
// Activity / Timeline — source of truth for what agents (or humans) did
// ---------------------------------------------------------------------------

enum ActivityType {
  email_sent
  email_opened
  email_clicked
  email_replied
  call_logged
  note
  status_change
  meeting_booked
  enrichment_completed
  score_updated
}

enum ActivityActor {
  agent
  human
  system
}

model Activity {
  id        String        @id @default(uuid())
  leadId    String        @map("lead_id")
  type      ActivityType
  actor     ActivityActor @default(system)
  agentName String?       @map("agent_name")
  payload   Json?
  createdAt DateTime      @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("activities")
}

model EmailLog {
  id             String    @id @default(uuid())
  leadId         String    @map("lead_id")
  sequenceStepId String?   @map("sequence_step_id")
  subject        String
  body           String
  sentAt         DateTime  @default(now()) @map("sent_at")
  openedAt       DateTime? @map("opened_at")
  clickedAt      DateTime? @map("clicked_at")
  repliedAt      DateTime? @map("replied_at")
  messageId      String?   @map("message_id")
  threadId       String?   @map("thread_id")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([threadId])
  @@map("email_logs")
}

// ---------------------------------------------------------------------------
// Agent configuration — drives what n8n workflows read at runtime
// ---------------------------------------------------------------------------

enum AgentType {
  enricher
  scorer
  writer
  classifier
  scheduler
  orchestrator
  housekeeping
  prospector
}

model Agent {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  name         String
  type         AgentType
  systemPrompt String    @map("system_prompt")
  // Google AI Studio (Gemini API) model slug, called via its OpenAI-compatible
  // /chat/completions endpoint — see n8n-workflows/README.md for the request
  // shape every agent uses. Keep in sync with DEFAULT_AGENT_MODEL in
  // src/lib/constants.ts (Prisma schema can't import a JS constant).
  model        String    @default("gemma-4-31b-it")
  isActive     Boolean   @default(true) @map("is_active")
  config       Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  runs         AgentRun[]

  @@index([orgId, type])
  @@map("agents")
}

enum AgentRunStatus {
  success
  failure
  needs_review
}

model AgentRun {
  id          String         @id @default(uuid())
  agentId     String         @map("agent_id")
  leadId      String?        @map("lead_id")
  input       Json
  output      Json?
  status      AgentRunStatus @default(success)
  latencyMs   Int?           @map("latency_ms")
  reviewedAt  DateTime?      @map("reviewed_at")
  reviewedBy  String?        @map("reviewed_by")
  createdAt   DateTime       @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lead  Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([status])
  @@map("agent_runs")
}

// ---------------------------------------------------------------------------
// Integrations & inbound webhook audit log
// ---------------------------------------------------------------------------

enum IntegrationProvider {
  n8n
  apollo
  clearbit
  hunter
  postmark
  sendgrid
  ses
  gmail
  microsoft_graph
  cal_com
  google_calendar
  openrouter
}

enum IntegrationStatus {
  connected
  disconnected
  error
}

model Integration {
  id            String              @id @default(uuid())
  orgId         String              @map("org_id")
  provider      IntegrationProvider
  credentialRef String?             @map("credentials_ref")
  status        IntegrationStatus   @default(disconnected)
  connectedAt   DateTime?           @map("connected_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider])
  @@map("integrations")
}

model WebhookInboundLog {
  id          String   @id @default(uuid())
  source      String
  dedupeKey   String   @unique @map("dedupe_key")
  payload     Json
  processed   Boolean  @default(false)
  receivedAt  DateTime @default(now()) @map("received_at")

  @@map("webhooks_inbound_log")
}
